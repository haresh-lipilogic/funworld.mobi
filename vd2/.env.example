# Copy this file to .env and fill in real values. .env is gitignored.

# Primary DB cluster (dbdetail.php, worldforher, beautytips)
DB_HOST=
DB_USER=
DB_PASS=

# Glamportal DB cluster (beautytips/glamportal)
DB_HOST_GLAMPORTAL=

# API credentials (includes/dbdetail.php)
API_CLIENT_KEY=
API_CLIENT_SECRET=

# SFTP credentials (filedownload.php)
SFTP_HOST=
SFTP_USER=
SFTP_PASS=

# Gamebar (gamebar/include/connection.php)
GAMEBAR_DB_HOST=
GAMEBAR_PARTNER_ID=
GAMEBAR_PRODUCT_ID=
GAMEBAR_SERVICE_ID=
GAMEBAR_PASSWORD=
