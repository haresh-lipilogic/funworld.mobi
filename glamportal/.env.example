# Copy this file to .env and fill in real values. .env is gitignored.

# Shared DB user/pass (used across all hosts below)
DB_USER=
DB_PASS=

# Root dbdetail.php
DB_HOST=

# includes/dbdetail.php - main cluster ($conn1)
DB_HOST_MAIN=

# includes/dbdetail.php - root/PDO connection ($connf), same host as DB_HOST_MAIN
DB_ROOT_USER=
DB_ROOT_PASS=

# Secondary DB cluster (category2.php, index1.php, index16.php, games/*)
DB_HOST_SECONDARY=

# Glambar OAuth/API credentials (includes/dbdetail.php)
GLAMBAR_USERNAME=
GLAMBAR_PASSWORD=
GLAMBAR_CLIENT_ID=
GLAMBAR_CLIENT_SECRET=
GLAMBAR_API_KEY=
GLAMBAR_SERVICE_ID=
